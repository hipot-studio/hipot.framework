.idea
# /.gitignore
/web.config
/*web.config
/*.log
/*.sql
# исключаем из репозитория текстовые файлы, но оставляем robots.txt
/*.txt
/sitemap*.xml
/*.dt
/*.tar.gz
/*.gz
/*.tar
/*.bak
/*.old
/*~
*/_*
/404_cache.html
vendor
*.lock
*.min.js
*.min.css

# исключаем ВСЮ папку bitrix, но ниже настроим включение нужных папок
# или используйте папку /local, чтобы полностью исключить папку bitrix
/bitrix/*
# включаем папку php_interface и исключаем файл dbconn.php
!/bitrix/php_interface/
!/bitrix/modules/sale/admin/print.php
!/bitrix/admin/.left.menu.php
!/bitrix/admin/.access.php
!/bitrix/modules/
!bitrix/html_pages/.config.php
/bitrix/php_interface/*.bak
!/bitrix/.settings.php
# исключаем служебные и ненужные папки проекта
/acrit.exportpro
/catalog_test
/images
/m
/sql_export
/upload

# misc
.unsorted
.junie
.phpunit.cache/